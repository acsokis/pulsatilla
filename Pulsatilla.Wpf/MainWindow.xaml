<Window x:Class="Pulsatilla.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pulsatilla.Wpf"
        Title="{DynamicResource Loc_B3CF963023EA}" Height="900" Width="1500"
        MinHeight="700" MinWidth="1120" Background="{DynamicResource Theme_050807}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="{DynamicResource ThemeColor_ED0A100D}" />
        <SolidColorBrush x:Key="BorderLine" Color="{DynamicResource ThemeColor_31513B}" />
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Theme_D8FFE0}" />
            <Setter Property="Background" Value="{DynamicResource Theme_14241A}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme_477853}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme_254C35}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme_305C42}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Theme_82C796}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="TrafficToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource Theme_14241A}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme_477853}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="9,4" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Theme_254C35}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ProtectionInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Theme_07100B}" /><Setter Property="Foreground" Value="{DynamicResource Theme_F0F5F1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme_60816A}" /><Setter Property="Padding" Value="8" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
        <Style x:Key="ProtectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme_CEDFD3}" /><Setter Property="Margin" Value="0,10,0,5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:TrafficSourceNode}" ItemsSource="{Binding Details}">
            <StackPanel Margin="0,3,0,5">
                <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Theme_E6F2E8}" TextWrapping="Wrap" FontSize="11" />
                <ProgressBar Value="{Binding Weight, Mode=OneWay}" Maximum="1" Height="3" Margin="0,5,0,0" Foreground="{DynamicResource Theme_75DE88}" Background="{DynamicResource Theme_203728}" BorderThickness="0" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <Style x:Key="SourceTreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme_CEDFD3}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
    </Window.Resources>
