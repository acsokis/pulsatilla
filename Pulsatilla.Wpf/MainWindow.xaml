                                    <TextBlock Style="{StaticResource ProtectionLabel}" Text="Set watched email addresses in Email &amp; phishing review, then import a CSV or JSON report you already have. Only matching addresses are displayed. This is an offline report check, not a live dark-web search." />
                                    <TextBlock Style="{StaticResource ProtectionLabel}" Text="CSV columns: email,service,date. JSON: an array of objects with these fields. Passwords and other columns are not displayed or saved." />
                                </StackPanel>
                                <WrapPanel Grid.Row="1" Margin="0,10,0,14">
                                    <Button Content="Import local report" Style="{StaticResource ActionButton}" Click="ImportExposureReportButton_Click" Margin="0,0,8,0" />
                                    <Button Content="Clear report" Style="{StaticResource ActionButton}" Click="ClearExposureReportButton_Click" />
                                </WrapPanel>
                                <DataGrid Grid.Row="2" x:Name="ExposureResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" FlowDirection="LeftToRight">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Watched email" Binding="{Binding Email}" Width="2*" />
                                        <DataGridTextColumn Header="Reported service" Binding="{Binding Service}" Width="2*" />
                                        <DataGridTextColumn Header="Reported date" Binding="{Binding ReportedDate}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="3" x:Name="ExposureStatusText" Text="No local report loaded." Foreground="{DynamicResource Theme_AFC5B7}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <TextBlock x:Name="ProtectionStatus" Grid.Row="1" Text="Preferences and application rules are stored locally." Foreground="{DynamicResource Theme_C8DDCF}" TextWrapping="Wrap" Margin="4,12,4,0" />
                </Grid>
              </TabItem>
              <TabItem x:Name="AboutTab" Header="About" Background="{DynamicResource Theme_101B13}" Foreground="{DynamicResource Theme_D8E4DA}">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource PanelBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PULSATILLA" Foreground="{DynamicResource Theme_F1F8F2}" FontSize="25" FontWeight="Bold" />
                                <TextBlock x:Name="ProductTaglineText" Text="Network clarity. Security insight." Foreground="{DynamicResource Theme_91A69A}" Margin="0,5,0,0" />
                                <TextBlock x:Name="AboutVersionText" Foreground="{DynamicResource Theme_91A69A}" Margin="0,5,0,12" />
                                <TextBlock Text="Pulsatilla development &amp; product direction" Foreground="{DynamicResource Theme_829488}" />
                                <TextBlock x:Name="CreatorNameText" Foreground="{DynamicResource Theme_F0F5F1}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,4" />
                                <TextBlock Text="{x:Static local:ProductInfo.Company}" Foreground="{DynamicResource Theme_CEDFD3}" Margin="0,0,0,4" />
                                <TextBlock x:Name="CreatorLocationText" Foreground="{DynamicResource Theme_CEDFD3}" />
                                <TextBlock Text="Original home project: netw_tool_v05" Foreground="{DynamicResource Theme_829488}" Margin="0,12,0,3" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OriginCreatorText" Text="Göldner Iván · Hungary" Foreground="{DynamicResource Theme_F0F5F1}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button x:Name="OriginFacebookButton" Content="Facebook" Style="{StaticResource ActionButton}" Margin="12,0,0,0"
                                            Tag="{x:Static local:AboutContent.OriginalCreatorFacebook}" ToolTip="{x:Static local:AboutContent.OriginalCreatorFacebook}" Click="CreatorLinkButton_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="400">
                                <TextBlock Text="Connect with the creator" Foreground="{DynamicResource Theme_E6F2E8}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <Button x:Name="InstagramButton" Content="Instagram" Style="{StaticResource ActionButton}" Click="CreatorLinkButton_Click" Margin="0,0,8,8" />
                                    <Button x:Name="LinkedinButton" Content="LinkedIn" Style="{StaticResource ActionButton}" Click="CreatorLinkButton_Click" Margin="0,0,8,8" />
                                    <Button x:Name="FacebookButton" Content="Facebook" Style="{StaticResource ActionButton}" Click="CreatorLinkButton_Click" Margin="0,0,8,8" />
                                    <Button x:Name="GithubButton" Content="GitHub" Style="{StaticResource ActionButton}" Click="CreatorLinkButton_Click" Margin="0,0,0,8" />
                                </WrapPanel>
                                <Button x:Name="SupportButton" Content="Support via PayPal" Style="{StaticResource ActionButton}"
                                        Tag="{x:Static local:ProductInfo.SupportUrl}" ToolTip="{x:Static local:ProductInfo.SupportUrl}"
                                        Click="CreatorLinkButton_Click" HorizontalAlignment="Left" Margin="0,4,0,6" />
                                <TextBlock Text="Voluntary support. The MIT Community core remains available without payment."
                                           Foreground="{DynamicResource Theme_91A69A}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="Technology: .NET &amp; WPF by Microsoft. Optional integrations: Nmap and Ollama." Foreground="{DynamicResource Theme_91A69A}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="0">
                        <TabControl x:Name="AboutDocumentsTabs" Margin="12" Background="Transparent" BorderThickness="0">
                            <TabItem Header="README" Background="{DynamicResource Theme_101B13}" Foreground="{DynamicResource Theme_D8E4DA}"><FlowDocumentScrollViewer x:Name="ReadmeViewer" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" /></TabItem>
                            <TabItem Header="Origin story" Background="{DynamicResource Theme_101B13}" Foreground="{DynamicResource Theme_D8E4DA}"><FlowDocumentScrollViewer x:Name="OriginViewer" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" /></TabItem>
                            <TabItem Header="License" Background="{DynamicResource Theme_101B13}" Foreground="{DynamicResource Theme_D8E4DA}"><FlowDocumentScrollViewer x:Name="LicenseViewer" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" /></TabItem>
                            <TabItem Header="Services" Background="{DynamicResource Theme_101B13}" Foreground="{DynamicResource Theme_D8E4DA}"><FlowDocumentScrollViewer x:Name="ServicesViewer" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" /></TabItem>
                            <TabItem Header="Privacy" Background="{DynamicResource Theme_101B13}" Foreground="{DynamicResource Theme_D8E4DA}"><FlowDocumentScrollViewer x:Name="PrivacyViewer" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" /></TabItem>
                        </TabControl>
                    </Border>
                </Grid>
              </TabItem>
            </TabControl>
            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <ComboBox x:Name="ThemeSelector" DockPanel.Dock="Right" Width="105" Margin="12,-5,0,-5" FlowDirection="LeftToRight" DisplayMemberPath="Name" SelectedValuePath="Mode" ToolTip="Color theme (Dark is the default)" SelectionChanged="ThemeSelector_SelectionChanged" />
                <ComboBox x:Name="LanguageSelector" DockPanel.Dock="Right" Width="170" Margin="12,-5,0,-5"
                          FlowDirection="LeftToRight" DisplayMemberPath="NativeName" SelectedValuePath="Code"
                          ToolTip="{DynamicResource Loc_A4FE65264EF7}" SelectionChanged="LanguageSelector_SelectionChanged" /><TextBlock Text="{DynamicResource Loc_AC7AAB22A5AA}" Foreground="{DynamicResource Theme_9AA99F}" FontSize="10" /><TextBlock x:Name="LastUpdateLabel" DockPanel.Dock="Right" Text="{DynamicResource Loc_E65C2D958C60}" Foreground="{DynamicResource Theme_9AA99F}" FontSize="10" HorizontalAlignment="Right" /></DockPanel>
        </Grid>
    </Grid>
</Window>
