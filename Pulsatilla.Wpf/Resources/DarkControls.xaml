<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ReadableComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme_F0F5F1}" /><Setter Property="Background" Value="{DynamicResource Theme_0C1810}" />
        <Setter Property="Padding" Value="10,7" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme_254C35}" /><Setter Property="Foreground" Value="{DynamicResource Theme_FFFFFF}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme_305C42}" /><Setter Property="Foreground" Value="{DynamicResource Theme_FFFFFF}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Theme_A0B0A5}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ReadableComboBoxItem}" />
    <Style x:Key="ReadableComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme_F0F5F1}" /><Setter Property="Background" Value="{DynamicResource Theme_0C1810}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme_60816A}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" /><Setter Property="MaxDropDownHeight" Value="340" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ReadableComboBoxItem}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="3">
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource Theme_E2F3E7}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" />
                            </Border>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Margin="8,5,28,5" IsHitTestVisible="False" VerticalAlignment="Center"
                                      Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                        <Border Background="{DynamicResource Theme_0C1810}" BorderBrush="{DynamicResource Theme_60816A}" BorderThickness="1" CornerRadius="3"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <ScrollViewer Margin="1" VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Theme_98E9AE}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ReadableComboBox}" />
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource Theme_101B13}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme_D8E4DA}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TabItem">
                <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Theme_31513B}" BorderThickness="1" Padding="{TemplateBinding Padding}" Margin="0,0,3,0">
                    <ContentPresenter x:Name="HeaderContent" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Theme_254C35}" />
                        <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Theme_82C796}" />
                        <Setter TargetName="HeaderContent" Property="TextElement.Foreground" Value="{DynamicResource Theme_FFFFFF}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Theme_82C796}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Theme_C3F1CF}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Theme_162D1F}" /><Setter Property="Foreground" Value="{DynamicResource Theme_EBF8EF}" />
        <Setter Property="Padding" Value="10,8" /><Setter Property="BorderBrush" Value="{DynamicResource Theme_31513B}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource Theme_E6F2E8}" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="5,3" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Theme_305C42}" /><Setter Property="Foreground" Value="{DynamicResource Theme_FFFFFF}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Theme_0C1810}" /><Setter Property="Foreground" Value="{DynamicResource Theme_E6F2E8}" />
        <Setter Property="RowBackground" Value="{DynamicResource Theme_0C1810}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource Theme_112318}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme_31513B}" /><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Theme_203728}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Theme_203728}" /><Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" /><Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="EnableRowVirtualization" Value="True" /><Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource {x:Type DataGridColumnHeader}}" />
        <Setter Property="CellStyle" Value="{StaticResource {x:Type DataGridCell}}" />
    </Style>
</ResourceDictionary>
