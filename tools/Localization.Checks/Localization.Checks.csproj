<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Pulsatilla.Wpf/ProductInfo.cs" Link="ProductInfo.cs" />
    <Compile Include="../../Pulsatilla.Wpf/AppStorage.cs" Link="AppStorage.cs" />
    <Compile Include="../../Pulsatilla.Wpf/LocalizationService.cs" Link="LocalizationService.cs" />
    <EmbeddedResource Include="../../Pulsatilla.Wpf/Resources/Locales/*.json"
                      LogicalName="Pulsatilla.Wpf.Resources.Locales.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
